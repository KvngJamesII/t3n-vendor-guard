# Tenant developer key from https://terminal3.io/products/agent-developer-kit (shown once)
T3N_API_KEY=0x_your_tenant_key
# Separate agent key — claim again from the same page (never reuse tenant key)
AGENT_KEY=0x_your_agent_key
# Optional: data-owner key for delegation demos (can equal tenant for self-grant demos)
USER_KEY=0x_your_user_key
T3N_ENV=testnet
# After registration, persist these:
# TENANT_DID=did:t3n:...
# AGENT_DID=did:t3n:...
# CONTRACT_TAIL=vendor-guard
# CONTRACT_VERSION=0.1.0
